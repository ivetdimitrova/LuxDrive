@* Интегриране на специализиран ViewModel за сигурно пренасяне на потребителските данни между слоевете *@
@model LuxDrive.ViewModels.Settings.UserSettingsViewModel
@{
    /* Дефиниране на мета-заглавие и логика за запазване на активния изглед (Active Tab) */
    /* Използва се TempData за съхранение на състоянието на UI след POST заявка (Post-Redirect-Get патърн) */
    ViewData["Title"] = "Account Settings";
    var activeTab = TempData["ActiveTab"] as string ?? "profile";
}

@* Прилагане на механизъм за cache-busting чрез Tag Helper-а asp-append-version *@
<link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />

@* Система за контекстуална обратна връзка (Feedback Loop) чрез Toast нотификации *@
@if (TempData["Success"] != null || TempData["Error"] != null)
{
    <div id="force-toast-container">
        @if (TempData["Success"] != null)
        {
            @* Визуализация на успешно изпълнена операция с икони за достъпност *@
            <div class="force-toast success"><i class="fas fa-check"></i> @TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            @* Визуализация на системни или логически грешки *@
            <div class="force-toast error"><i class="fas fa-times"></i> @TempData["Error"]</div>
        }
    </div>
}

@* Използване на data-атрибути за безпроблемна комуникация между сървърната логика и JavaScript клиента *@
<div class="settings-container" data-active-tab="@activeTab">
    <div class="settings-header">
        <h1>Account <span class="gold-text">Settings</span></h1>
        <p>Manage your profile, security, and cards information.</p>
    </div>

    <div class="settings-layout">
        @* Навигационен панел за табове: Оптимизира пространството и намалява когнитивното натоварване *@
        <div class="settings-sidebar">
            <button id="btn-profile" class="tab-btn active" onclick="openTab(event, 'profile')"><i class="fas fa-user"></i> Profile</button>
            <button id="btn-security" class="tab-btn" onclick="openTab(event, 'security')"><i class="fas fa-lock"></i> Security</button>
            <button id="btn-billing" class="tab-btn" onclick="openTab(event, 'billing')"><i class="fas fa-credit-card"></i> Cards</button>
            <button id="btn-danger" class="tab-btn danger" onclick="openTab(event, 'danger')"><i class="fas fa-trash-alt"></i> Delete Account</button>
        </div>

        <div class="settings-content">

            @* Секция: Управление на профила и мултимедийно съдържание *@
            <div id="profile" class="tab-content">
                <h2 class="gold-text" style="margin-bottom: 20px;">Profile Information</h2>
                @* enctype="multipart/form-data" е критично за коректния стрийминг на IFormFile обекти *@
                <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                    <div class="profile-upload-section">
                        @* Динамично зареждане на аватар с fallback механизъм *@
                        <div class="profile-img-container">
                            <img src="@Model.ProfileImageUrl" id="profile-preview" alt="Profile" />
                        </div>
                        <div class="button-group-lux">
                            @* Програмно задействане на системния диалог за избор на файл (UX Trick) *@
                            <input asp-for="ProfileImage" type="file" id="imageInput" style="display:none;" accept="image/*" onchange="handleImageUpload(event)" />
                            <button type="button" class="btn-lux-change" onclick="document.getElementById('imageInput').click()">EDIT PHOTO</button>
                            <button type="button" class="btn-lux-outline" onclick="markForRemoval()">Remove</button>
                        </div>
                        <p class="upload-info">JPG, PNG or WEBP • Max 2MB</p>
                        @* Скрит вход за флагово управление на състоянието на аватара *@
                        <input type="hidden" name="RemovePhoto" id="removePhotoFlag" value="false" />
                    </div>

                    @* Полета за идентификация: Username е деактивиран (Read-only) за запазване на системния интегритет *@
                    <div class="form-group">
                        <label>Username</label>
                        <input asp-for="Username" class="lux-input" disabled />
                    </div>

                    @* Организация на данните в редове за по-добър визуален ритъм (Form Layouting) *@
                    <div class="form-row">
                        <div class="form-group">
                            <label>First Name</label>
                            <input asp-for="FirstName" id="firstNameInput" class="lux-input" />
                            <span asp-validation-for="FirstName" style="color:#ff4d4d; display:block; margin-top:5px;"></span>
                        </div>
                        <div class="form-group">
                            <label>Last Name</label>
                            <input asp-for="LastName" id="lastNameInput" class="lux-input" />
                            <span asp-validation-for="LastName" style="color:#ff4d4d; display:block; margin-top:5px;"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Email Address</label>
                        <input asp-for="Email" class="lux-input" type="email" />
                        <span asp-validation-for="Email" style="color:#ff4d4d; display:block; margin-top:5px;"></span>
                    </div>

                    <div class="form-group">
                        <label>Phone Number</label>
                        <input asp-for="PhoneNumber" id="phoneInput" class="lux-input" type="tel" />
                        <span asp-validation-for="PhoneNumber" style="color:#ff4d4d; display:block; margin-top:5px;"></span>
                    </div>
                    <button type="submit" class="btn-gold">Save Changes</button>
                </form>
            </div>

            @* Секция: Сигурност и криптографско управление на пароли *@
            <div id="security" class="tab-content" style="display:none;">
                <h2>Change Password</h2>
                <form asp-action="ChangePassword" method="post">
                    @* Използване на PasswordBox за предотвратяване на визуална кражба на данни *@
                    <div class="form-group">
                        <label>Current Password</label>
                        <input asp-for="CurrentPassword" type="password" class="lux-input" />
                        <span asp-validation-for="CurrentPassword" style="color:#ff4d4d;"></span>
                    </div>
                    <div class="form-group">
                        <label>New Password</label>
                        <input asp-for="NewPassword" type="password" class="lux-input" />
                        <span asp-validation-for="NewPassword" style="color:#ff4d4d;"></span>
                    </div>
                    <div class="form-group">
                        <label>Confirm New Password</label>
                        <input asp-for="ConfirmNewPassword" type="password" class="lux-input" />
                        <span asp-validation-for="ConfirmNewPassword" style="color:#ff4d4d;"></span>
                    </div>
                    <button type="submit" class="btn-gold">Update Password</button>
                </form>
            </div>

            @* Секция: Разплащателни инструменти и PCI-метаданни *@
            <div id="billing" class="tab-content" style="display:none;">
                <h2 class="gold-text">Saved Cards</h2>
                <div class="cards-list">
                    @* Итерация през колекция от маскирани данни за карти (Security Compliance) *@
                    @if (Model.SavedCards != null && Model.SavedCards.Any())
                    {
                        foreach (var card in Model.SavedCards)
                        {
                            <div class="card-item">
                                <div class="card-info">
                                    @* Динамична визуализация на бранда на картата чрез FontAwesome *@
                                    <i class="fab fa-cc-@card.CardType.ToLower()" style="font-size:1.5rem; margin-right:10px;"></i>
                                    <span>**** **** **** @card.CardLast4</span>
                                </div>
                                @* Малко-мащабни форми за управление на записи (CRUD - Delete) *@
                                <form asp-action="RemoveCard" method="post" style="margin:0;">
                                    <input type="hidden" name="cardId" value="@card.Id" />
                                    <button type="submit" class="btn-remove">Remove</button>
                                </form>
                            </div>
                        }
                    }
                    else
                    {
                        @* Празно състояние (Empty State) за поддържане на интерфейсна яснота *@
                        <p style="color:#666; margin-bottom: 20px;">No cards saved yet.</p>
                    }
                </div>
                <hr style="border-color:rgba(255,255,255,0.1); margin: 30px 0;" />
                <h3 class="gold-text">Add New Card</h3>
                @* Форма за въвеждане на нови платежни инструменти с вградена клиентска валидация *@
                <form asp-action="AddCard" method="post">
                    <div class="form-group">
                        <label>Name on Card</label>
                        <input asp-for="NewCardName" id="newCardName" class="lux-input" placeholder="John Doe" />
                        <span asp-validation-for="NewCardName" style="color:#ff4d4d; display:block; margin-top:5px;"></span>
                    </div>
                    <div class="form-group">
                        <label>Card Number</label>
                        <input asp-for="NewCardNumber" id="cardNumber" class="lux-input" placeholder="0000 0000 0000 0000" maxlength="19" />
                        <span asp-validation-for="NewCardNumber" style="color:#ff4d4d; display:block; margin-top:5px;"></span>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Expiry (MM/YY)</label>
                            <input asp-for="NewCardExpiry" id="cardExpiry" class="lux-input" placeholder="MM/YY" maxlength="5" />
                            <span asp-validation-for="NewCardExpiry" style="color:#ff4d4d; display:block; margin-top:5px;"></span>
                        </div>
                        <div class="form-group">
                            <label>CVC</label>
                            <input asp-for="NewCardCvc" id="cardCvc" class="lux-input" placeholder="123" maxlength="3" />
                            <span asp-validation-for="NewCardCvc" style="color:#ff4d4d; display:block; margin-top:5px;"></span>
                        </div>
                    </div>
                    <button type="submit" class="btn-outline-gold" style="margin-top: 15px;">+ Add Card</button>
                </form>
            </div>

            @* Зона за критични действия (Danger Zone): Необратими операции *@
            <div id="danger" class="tab-content" style="display:none;">
                <h2 class="text-danger">Delete Account</h2>
                <p>Deleting your account is permanent. All your data will be wiped immediately.</p>
                <div style="margin-top: 20px;">
                    @* Потвърждение на ниво клиент (JS Confirm) за превенция на неволни деструктивни действия *@
                    <form asp-action="DeleteAccount" method="post" onsubmit="return confirm('WARNING: Are you sure you want to delete your account? This cannot be undone!');">
                        @* Защита срещу Cross-Site Request Forgery (CSRF) *@
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-danger-glow">DELETE ACCOUNT</button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @* Зареждане на клиентски скриптове за табовете и маскиране на входните данни *@
    <script src="~/js/settings.js" asp-append-version="true"></script>
    @{
        @* Рендиране на частичния изглед за Unobtrusive Validation за асинхронна проверка на полетата *@
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}