@model LuxDrive.ViewModels.Friends.ShareWithFriendViewModel

<div class="modal-content">
    <h4>Share file</h4>

    <form asp-controller="File"
          asp-action="Share"
          method="post">

        <input type="hidden" asp-for="FileId" />

        <select asp-for="ReceiverId" class="form-select" required>
            <option value="">-- Select a friend --</option>
            @foreach (var f in Model.Friends)
            {
                <option value="@f.Id">
                    @f.Name
            </option>
                        }
        </select>

        <button type="submit" class="btn btn-primary mt-2">
            Share
        </button>
    </form>
</div>
