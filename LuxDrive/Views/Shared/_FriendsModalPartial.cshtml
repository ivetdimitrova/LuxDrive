@using LuxDrive.ViewModels.Friends;
@model FriendsMainViewModel

<div class="social-hub">
    <div class="modal-header-custom">
        <div class="header-title">
            <i class="fas fa-users yellow-text"></i>
            <span>Friends</span>
        </div>
        <span class="close-btn" onclick="closeFriendsTab()">&times;</span>
    </div>

    <div class="modal-tabs">
        <button class="tab-link active" onclick="openTab('MyFriends')">My Friends</button>
        <button class="tab-link" onclick="openTab('AddNew')">Add New</button>
        <button class="tab-link" onclick="openTab('Requests')">Requests</button>
    </div>

    <div id="MyFriends" class="tab-content" style="display: block;">
        @if (Model.Friends != null && Model.Friends.Any())
        {
            @foreach (var friend in Model.Friends)
            {
                <div class="friend-row">
                    <div class="friend-avatar">
                        @if (!string.IsNullOrEmpty(friend.ProfileImageUrl))
                        {
                            <img src="@friend.ProfileImageUrl" alt="@friend.Name" class="avatar-img" />
                        }
                        else
                        {
                            <div class="avatar-letter">
                                @friend.Name.First()
                            </div>
                        }
                    </div>
                    <div class="friend-info">
                        <div class="friend-name">@friend.Name</div>
                        <div class="friend-email">@friend.Email</div>
                    </div>
                    <div class="friend-actions">
                        <i class="fas fa-eye info-icon"></i>
                        <form asp-controller="Friends" asp-action="RemoveFriend" method="post">
                            <input type="hidden" name="friendId" value="@friend.Id" />

                            <button type="submit" >
                                <i class="fas fa-user-minus remove-icon"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <p style="text-align:center;color:#666;padding:20px;">No friends added yet.</p>
        }

    </div>

    <div id="AddNew" class="tab-content" style="display: none;">
        <p class="input-label">Enter email to send an invite:</p>
        <div class="invite-box">
            <form asp-controller="Friends"
                  asp-action="Send"
                  method="post">

                <input type="email"
                       name="receiverEmail"
                       class="custom-input"
                       placeholder="friend@example.com"
                       required />

                <button type="submit" class="btn-invite">INVITE</button>
            </form>
        </div>
        <div class="pending-section">
            <p class="small-label">SENT PENDING REQUESTS</p>
            @if (Model.SentRequests != null && Model.SentRequests.Any())
            {
                @foreach (var request in Model.SentRequests)
                {
                    <div style="display:flex; justify-content:space-between; padding:12px; border-bottom:1px solid #222;">
                        <span>@request.ReceiverName</span><span style="color:var(--gold)">
                            Pending
                        </span>
                    </div>
                }

            }
            else
            {
                <p class="empty-msg">No sent requests.</p>
            }

        </div>
</div>
    <div id="Requests" class="tab-content" style="display: none;">
        @if (Model.ReceivedRequests != null && Model.ReceivedRequests.Any())
        {
            @foreach (var request in Model.ReceivedRequests)
            {
                <div class="req-card">
                    <div class="user-avatar">
                        @if (!string.IsNullOrEmpty(request.ProfileImageUrl))
                        {
                            <img src="@request.ProfileImageUrl" alt="@request.SenderName" class="avatar-img" />
                        }
                        else
                        {
                            <div class="avatar-letter">
                                @request.SenderName.First()
                            </div>
                        }
                    </div>
                    <div style="margin-left:10px;">@request.SenderName</div>
                    <div class="req-actions">
                        <form asp-controller="Friends" asp-action="Accept" method="post">
                            <input type="hidden" name="requestId" value="@request.Id" />
                            <button type="submit" class="btn-yes">Accept</button>
                        </form>
                        <form asp-controller="Friends" asp-action="Reject" method="post">
                            <input type="hidden" name="requestId" value="@request.Id" />
                            <button class="btn-no">Reject</button>
                        </form>
                      
                    </div>
                </div>
            }
        }
        else
        {
            <p class="empty-msg center">No incoming requests.</p>
        }

    </div>

</div>
