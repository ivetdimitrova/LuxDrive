@using LuxDrive.ViewModels.File;
@model IEnumerable<IndexViewModel>

@{
    ViewData["Title"] = "LuxDrive Dashboard";
    var currentAction = "Index";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/fileIndex.css" asp-append-version="true" />

<div class="app-wrapper">

    <aside class="sidebar">
        <div class="nav-section" style="margin-top:20px;">
            <div class="nav-title">Menu</div>

            <a asp-controller="File" asp-action="Index" class="nav-item active">
                <i class="fas fa-house"></i> All Files
            </a>

            <a asp-controller="File" asp-action="SharedWithMe" class="nav-item">
                <i class="fas fa-share-nodes"></i> Shared
            </a>

            <a href="#" class="nav-item" onclick="openHub()">
                <i class="fas fa-user-group"></i> Friends
            </a>

            <a asp-controller="Settings" asp-action="Index" class="nav-item">
                <i class="fas fa-cog"></i> Settings
            </a>

            <a asp-controller="File" asp-action="Trash" class="nav-item">
                <i class="fas fa-trash-can"></i> Trash Bin
            </a>
        </div>

        <div class="nav-section">
            <div class="nav-title">Libraries</div>
            <a href="#" class="nav-item" onclick="filterFiles(event,'image')"><i class="fas fa-images"></i> Photos</a>
            <a href="#" class="nav-item" onclick="filterFiles(event,'video')"><i class="fas fa-video"></i> Videos</a>
            <a href="#" class="nav-item" onclick="filterFiles(event,'document')"><i class="fas fa-file-contract"></i> Documents</a>
            <a href="#" class="nav-item" onclick="filterFiles(event,'archive')"><i class="fas fa-box-archive"></i> Archives</a>
        </div>
    </aside>

    <div class="content">

        <div class="top-header">
            <div class="search-bar">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Search" onkeyup="searchFiles(this.value)">
            </div>

            <form asp-controller="File" asp-action="Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <label for="file-upload" class="upload-btn">
                    <i class="fas fa-cloud-arrow-up"></i> Upload
                </label>
                <input type="file" id="file-upload" name="files" multiple hidden onchange="this.form.submit()" />
            </form>
        </div>

        <div class="files-grid">
            @foreach (var file in Model)
            {
                <div class="file-item"
                     id="file-@file.Id"
                     data-type="@file.Type"
                     data-download-url="@file.StorageUrl">

                    <div class="preview-box">
                        <div class="check-circle" onclick="toggleSelect(this,'@file.Id')"></div>

                        @if (file.Type == "image")
                        {
                            <img src="@file.StorageUrl" />
                        }
                        else
                        {
                            <i class="@file.Icon type-icon"></i>
                        }
                    </div>

                    <div class="file-info">
                        <h3>@file.Name</h3>
                        <p>@file.Extension • @file.UploadedAt.ToString("dd MMM")</p>
                    </div>
                </div>
            }

            <div id="empty-state" style="display:none; text-align:center; padding:40px;">
                <i class="fas fa-folder-open" style="font-size:3rem; opacity:.3"></i>
                <p id="empty-text">No files uploaded</p>
            </div>
        </div>

        <div id="bulkBar" class="bulk-bar">
            <span id="bulkCount">0 Selected</span>
        </div>
    </div>
</div>

<script src="~/js/file-ui.js"></script>
