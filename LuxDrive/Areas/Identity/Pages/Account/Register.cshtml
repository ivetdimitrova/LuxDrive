@page 
@model RegisterModel /* Свързване с модела за регистрация, съдържащ бизнес правилата и InputModel-а */
@{
    /* Задаване на мета-информация за Layout-а; Поддържане на консистентно заглавие на документа */
    ViewData["Title"] = "Join LuxDrive";
}

@* Интегриране на специфични стилове с 'cache-busting' механизъм за гарантиране на най-новата версия *@
<link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />

<div class="lux-register-wrapper">
    <div class="lux-card">

        <div class="brand-logo"><span class="glow">Lux</span>Drive</div>
        <p class="subtitle">Create your premium account today.</p>

        @* Използване на Tag Helpers за дефиниране на маршрута в Identity Area и управление на ReturnUrl *@
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" asp-area="Identity" asp-page="/Account/Register">
            
            @* Сумарен контейнер за грешки (Validation Summary), визуализиращ проблеми извън конкретните полета *@
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            @* Секция за лични данни, разделена на колони за по-добър визуален баланс (Grid system) *@
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-floating">
                        @* Клиентска валидация в реално време чрез 'oninput' и Regex: 
                           Позволява само букви (латиница/кирилица), интервали и тирета. 
                           Това е критично за предотвратяване на въвеждане на некоректни данни още преди Submit *@
                        <input asp-for="Input.FirstName" class="form-control" placeholder="First Name"
                               oninput="this.value = this.value.replace(/[^a-zA-Zа-яА-Я\s\-]/g, '')" />
                        <label asp-for="Input.FirstName">First Name</label>
                    </div>
                    @* Място за рендиране на съобщения за грешки от Data Annotations (напр. [Required]) *@
                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <div class="form-floating">
                        @* Повторение на логиката за филтриране и за фамилното име (Data Integrity) *@
                        <input asp-for="Input.LastName" class="form-control" placeholder="Last Name"
                               oninput="this.value = this.value.replace(/[^a-zA-Zа-яА-Я\s\-]/g, '')" />
                        <label asp-for="Input.LastName">Last Name</label>
                    </div>
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>
            </div>

            @* Електронна поща - използва стандартен HTML5 имейл тип за базова браузерна валидация *@
            <div class="form-floating mt-3">
                <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email Address</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            @* Парола - криптиран вход. Identity фреймуоркът автоматично ще приложи изискванията за сложност *@
            <div class="form-floating">
                <input asp-for="Input.Password" class="form-control" type="password" placeholder="Password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            @* Повторение на паролата - гарантира, че потребителят не е допуснал печатна грешка при регистрация *@
            <div class="form-floating">
                <input asp-for="Input.ConfirmPassword" class="form-control" type="password" placeholder="Confirm Password" />
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            @* Основен Call-to-Action бутон *@
            <button id="registerSubmit" type="submit" class="btn-lux">Get Started</button>

            @* Връзка към Login страницата за потребители, които вече имат акаунт (User flow optimization) *@
            <div class="auth-footer">
                Already have an account? <a asp-page="./Login">Log In</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @* Вмъкване на частичния изглед за Unobtrusive Validation – 
       позволява валидация на полетата без презареждане на цялата страница (AJAX-like experience) *@
    <partial name="_ValidationScriptsPartial" />
}